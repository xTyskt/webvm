# Phase 0 smoke test image — DO NOT skip this before trusting hostRuntime.js.
# Goal: confirm, on real CheerpX, before writing more integration code:
#   1. openjdk-17-jre-headless still installs on current Debian i386 repos
#   2. Paper boots past its self-attach agent (the actual CheerpJ blocker)
#   3. what -Xmx actually survives before the JVM refuses to start (should
#      land somewhere 1.5-2.5GB per the 32-bit address-space math)
#   4. rough tick performance under a bot-simulated player load
FROM i386/debian:bullseye

# Multiple JDKs — different Minecraft versions need different Java
# versions (older releases want Java 8, modern Paper wants 17+). One
# base image with all of them installed, selecting the right one per
# boot at runtime, is simpler than shipping separate images per JDK.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-8-jre-headless \
    openjdk-17-jre-headless \
    wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv
RUN echo "eula=true" > /srv/eula.txt

# NOTE: no server.jar COPY here on purpose. The actual Minecraft jar is
# fetched fresh per boot by hostRuntime.js's _fetchServerJar() (whatever
# vanilla/Paper version the user picked) and staged into /srv via the
# DataDevice mechanism — see hostRuntime.js's _stageWorldFilesIntoDataDevice().
# This image only needs to supply the OS + JDKs, so ONE image serves
# every Minecraft/Paper version, not just whatever was baked in at
# build time. For a quick manual smoke test only (not the real
# pipeline), you can temporarily add `COPY server.jar /srv/server.jar`
# back in to boot one fixed jar without needing hostRuntime.js at all.

